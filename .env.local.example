# =============================================================================
# ローカル開発用の環境変数のひな形。
# これを .env.local にコピーして使ってください(.env* は .gitignore 済み)。
#
#   cp .env.local.example .env.local
# =============================================================================

# --- 第2回模試(有料)をローカルで確認するための解除 -------------------------
# 決済を通さずに有料の紙面を開けるようにします。
# NODE_ENV=development のときだけ効き、next build した本番では絶対に有効に
# なりません(src/lib/access.ts の二重ガード)。解除中は画面に赤い帯が出ます。
# 決済フローそのものを試すときは、この行を消してください。
DEV_UNLOCK_MOSHI2=true

# --- 受験権 cookie の署名鍵(必須) -------------------------------------------
# 生成:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 【注意】本番で運用を始めたあとに変更すると、購入者全員が締め出されます。
# ACCESS_SECRET=

# --- Stripe ------------------------------------------------------------------
# 未設定でもページは正常に表示され、購入ボタンが「決済は現在準備中です。」を
# 返すだけです。決済フローを試すときだけテストキーを入れてください。
# テストカード: 4242 4242 4242 4242 / 有効期限は未来の日付 / CVCは任意の3桁
# 設定したら `npm run stripe:check` で診断できます。
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# webhook の署名シークレット。決済成立時に受験用リンクをメールで送るために使う。
# ローカルでは Stripe CLI で取得します:
#   stripe listen --forward-to localhost:3457/api/stripe-webhook/
# 末尾スラッシュ必須(trailingSlash: true のため。無いと308が返り Stripe は追わない)
# 未設定なら webhook は何もしません(メールが飛ばないだけで決済は通ります)。
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- メール送信(Resend) -----------------------------------------------------
# 決済後に受験用リンクを送るために使います。ドメイン認証(shikakumon.com)は
# シカクモン Studio 側で完了済みなので、APIキーだけで送れます。
# 未設定ならメールを送りません(決済と受験自体は問題なく動きます)。
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=シカクモン <noreply@shikakumon.com>

# --- growth-kit(回答ログ・利用データ・Studio 接続) 2026-09-13 ------------------
# 方針と契約は docs/growth-kit.md。どれも未設定で動く(送らない／出さない)。
#
# 回答ログの転送先(Studio の取り込みAPI)。未設定なら /api/answer-log/ は受け取って捨てる。
# STUDIO_INGEST_URL=https://studio.shikakumon.com/api/ingest/answers
# STUDIO_INGEST_SECRET=（Studio 側と同じ値。Authorization: Bearer で送る）
#
# 問題ごとの正答率・間違えた人が多い問題の出典(Studio の集計API)。未設定なら空を返す。
# STUDIO_STATS_URL=https://studio.shikakumon.com/api/stats/questions
#
# Studio の接続画面(/connect: リマインド登録・履歴同期)ができたら 1 にする。
# ビルド時に焼き込まれるので、変えたら再デプロイ。
# NEXT_PUBLIC_STUDIO_CONNECT=0
